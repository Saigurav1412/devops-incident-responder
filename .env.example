# Copy to .env and fill in. Never commit .env. See docs/INTERFACES.md §6.

# --- LLM ---
OPENAI_API_KEY=sk-...
LLM_MODEL=
EMBEDDING_MODEL=

# --- GCP ---
GCP_PROJECT=
FIRESTORE_DATABASE=(default)
EXECUTOR_URL=http://10.0.0.2:8080
# What the diagnoser's check_health curls (through the executor, so as seen from the VM).
# Must be one of the exact curl URLs in src/security/allowlist.yaml.
HEALTH_URL=http://127.0.0.1:8088/health
# Bearer token for POST/GET /incidents on the diagnoser (the monitor and eval harness send it).
# Left empty on purpose: intake refuses every request until a real token is set.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INCIDENT_API_TOKEN=

# --- Slack approval ---
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
APPROVER_ALLOWLIST=U00000000

# --- approval token (shared by diagnoser and executor; Secret Manager in cloud) ---
# Hex, at least 64 hex characters (32 bytes). Both services decode it with
# Settings.approval_key_bytes(); generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Left empty on purpose: the services refuse to start without a real key.
APPROVAL_SIGNING_KEY=
APPROVAL_TTL_S=900

# --- budgets ---
MAX_ITERATIONS=12
MAX_REPLANS=3
MAX_TOOL_CALLS=30
MAX_TOKENS_PER_INCIDENT=150000
MAX_WALL_CLOCK_S=600

# --- ablation switches ---
MEMORY_ENABLED=true
MAX_HYPOTHESES=3

# --- executor ---
ALLOWED_DIAGNOSER_SA=diagnoser-sa@PROJECT.iam.gserviceaccount.com
MAX_OUTPUT_BYTES=16384

# --- tracing ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-responder
